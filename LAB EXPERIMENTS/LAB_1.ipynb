      ],
      "source": [
        "import re\n",
        "\n",
        "text = \"Python is easy. Python is powerful.\"\n",
        "\n",
        "# Match pattern\n",
        "print(re.match(\"Python\", text))\n",
        "\n",
        "# Search pattern\n",
        "print(re.search(\"easy\", text))\n",
        "\n",
        "# Find all occurrences\n",
        "print(re.findall(\"Python\", text))\n",
        "\n",
        "# Replace text\n",
        "print(re.sub(\"Python\", \"Java\", text))"
      ]
    },

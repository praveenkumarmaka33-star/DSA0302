      "source": [
        "import nltk\n",
        "\n",
        "grammar = nltk.CFG.fromstring(\"\"\"\n",
        "S -> NP VP\n",
        "NP -> Det N\n",
        "VP -> V NP\n",
        "Det -> 'a'\n",
        "N -> 'cat' | 'mouse'\n",
        "V -> 'chased'\n",
        "\"\"\")\n",
        "\n",
        "parser = nltk.ChartParser(grammar)\n",
        "\n",
        "sentence = \"a cat chased a mouse\".split()\n",
        "\n",
        "for tree in parser.parse(sentence):\n",
        "    print(tree)\n",
        "    tree.draw()"
      ]
    }

      "source": [
        "import nltk\n",
        "\n",
        "patterns = [\n",
        "    (r'.*ing$', 'VBG'),\n",
        "    (r'.*ed$', 'VBD'),\n",
        "    (r'.*ly$', 'RB'),\n",
        "    (r'.*ous$', 'JJ'),\n",
        "    (r'.*s$', 'NNS'),\n",
        "    (r'.*', 'NN')\n",
        "]\n",
        "\n",
        "tagger = nltk.RegexpTagger(patterns)\n",
        "\n",
        "text = \"The boys are playing happily\"\n",
        "\n",
        "words = text.split()\n",
        "\n",
        "print(tagger.tag(words))"
      ]
    }
  ]
}
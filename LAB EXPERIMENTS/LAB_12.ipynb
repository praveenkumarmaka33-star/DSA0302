      ],
      "source": [
        "import nltk\n",
        "\n",
        "grammar = nltk.CFG.fromstring(\"\"\"\n",
        "S -> NP VP\n",
        "NP -> Det N\n",
        "VP -> V NP\n",
        "Det -> 'the'\n",
        "N -> 'boy' | 'ball'\n",
        "V -> 'kicked'\n",
        "\"\"\")\n",
        "\n",
        "parser = nltk.EarleyChartParser(grammar)\n",
        "\n",
        "sentence = \"the boy kicked the ball\".split()\n",
        "\n",
        "for tree in parser.parse(sentence):\n",
        "    print(tree)"
      ]
    }
  ]
}
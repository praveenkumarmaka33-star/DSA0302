        "!pip install nltk\n",
        "\n",
        "import nltk\n",
        "from nltk.stem import PorterStemmer\n",
        "\n",
        "ps = PorterStemmer()\n",
        "\n",
        "words = [\"playing\", \"played\", \"plays\", \"happiness\", \"cars\"]\n",
        "\n",
        "for word in words:\n",
        "    print(word, \":\", ps.stem(word))"

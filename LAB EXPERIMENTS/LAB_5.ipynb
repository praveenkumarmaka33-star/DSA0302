      "source": [
        "import nltk\n",
        "from nltk.stem import PorterStemmer\n",
        "\n",
        "ps = PorterStemmer()\n",
        "\n",
        "words = [\"playing\", \"running\", \"studies\",\n",
        "         \"happiness\", \"connected\"]\n",
        "\n",
        "for word in words:\n",
        "    print(word, \"->\", ps.stem(word))"
      ]
    }

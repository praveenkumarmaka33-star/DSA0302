      "source": [
        "import re\n",
        "\n",
        "n = int(input())\n",
        "\n",
        "pattern = r\"[A-Za-z]+(?:['-][A-Za-z]+)*\"\n",
        "\n",
        "for _ in range(n):\n",
        "    line = input()\n",
        "    tokens = re.findall(pattern, line)\n",
        "\n",
        "    if tokens:\n",
        "        print(len(tokens), *tokens)\n",
        "    else:\n",
        "        print(0)"
      ]
    }
